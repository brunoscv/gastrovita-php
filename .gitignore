# --- api/ (Lumen) ---
# vendor/ é versionado de propósito: o deploy é via FTP e o servidor não roda
# `composer install`. Ver README/DEPLOY para o passo a passo.
/api/.idea
/api/Homestead.json
/api/Homestead.yaml
/api/.env
/api/.phpunit.result.cache

# Uploads de usuário: a pasta existe (com .gitkeep), o conteúdo não é versionado.
/api/uploads/*
!/api/uploads/.gitkeep
!/api/uploads/doctors
!/api/uploads/insurances
!/api/uploads/testimonials
!/api/uploads/misc
/api/uploads/doctors/*
!/api/uploads/doctors/.gitkeep
/api/uploads/insurances/*
!/api/uploads/insurances/.gitkeep
/api/uploads/testimonials/*
!/api/uploads/testimonials/.gitkeep
/api/uploads/misc/*
!/api/uploads/misc/.gitkeep

# --- web/ (Next.js — buildado localmente, não versionamos node_modules nem a saída) ---
/web/node_modules
/web/.next
/web/out
/web/.env.local
/web/tsconfig.tsbuildinfo
/web/next-env.d.ts

# --- pacote final de deploy (gerado por deploy/build-package.sh, não versionado) ---
/dist

# --- dumps de banco (contém dados reais/hash de senha, nunca versionar) ---
/deploy/out
