APP_NAME=Gastrovita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gastrovita
DB_USERNAME=gastrovita
DB_PASSWORD=gastrovita

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Igual ao WEB_ORIGIN da API antiga: origem do frontend Next.js liberada no CORS
# e usada para montar as URLs de redirect pós-OAuth do YouTube.
WEB_ORIGIN=http://localhost:3000

# Chave de assinatura do cookie de sessão (equivalente ao JWT_SECRET da API Node).
JWT_SECRET=change-me-generate-a-long-random-string
JWT_TTL_DAYS=7

# Google Cloud Console > APIs & Services > Credentials (OAuth Client ID, tipo "Web application").
# O redirect URI cadastrado no Google precisa ser exatamente igual a YOUTUBE_REDIRECT_URI abaixo.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
